# ============================================
# AGENTFLOW — Environment Variables
# Copy this file to .env and fill in your keys
# ============================================

PORT=5000
NODE_ENV=development

# Make up any long random string — min 32 chars
JWT_SECRET=agentflow_change_this_to_something_random_32chars

# Supabase — https://supabase.com → Settings → API Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_anon_key
SUPABASE_SERVICE_KEY=sb_secret_your_service_key

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_key

# Dodo Payments — https://dodopayments.com
# Get your API key from the Dodo dashboard
DODO_API_KEY=your_dodo_api_key
# Set this webhook URL in Dodo dashboard → Webhooks:
# https://yourdomain.com/api/payments/webhook

# Gmail App Password — Google Account → Security → App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=yourgmailapppassword
EMAIL_FROM=AgentFlow <your_gmail@gmail.com>

# Twilio WhatsApp — https://console.twilio.com
# Set webhook URL in Twilio → Messaging → WhatsApp Sandbox:
# https://yourdomain.com/api/whatsapp/webhook
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your domain (localhost for development)
FRONTEND_URL=http://localhost:5000

# Google Calendar + Gmail OAuth
# Step 1: Go to console.cloud.google.com
# Step 2: New Project → name it AgentFlow
# Step 3: APIs & Services → Library → Enable "Google Calendar API" AND "Gmail API"
# Step 4: APIs & Services → Credentials → Create OAuth 2.0 Client ID
#         Type: Web Application
#         Authorized redirect URIs — add ALL of these:
#           http://localhost:5000/api/calendar/callback
#           http://localhost:5000/api/gmail/callback
#           https://yourdomain.com/api/calendar/callback
#           https://yourdomain.com/api/gmail/callback
# Step 5: Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback
GOOGLE_REDIRECT_URI_GMAIL=http://localhost:5000/api/gmail/callback
