# ==================================================
# AGENTFLOW — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to Git (only this .env.example).
# ==================================================

PORT=5000
NODE_ENV=development

# Public base URL of your app (http://localhost:5000 for development)
FRONTEND_URL=http://localhost:5000

# REQUIRED. Long random string, 32+ chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---------- Database: Supabase (https://supabase.com > Settings > API) ----------
# Without these the app uses an in-memory store and loses data on restart.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------- AI: OpenAI (https://platform.openai.com/api-keys) ----------
# Without a key the listing generator returns demo text.
OPENAI_API_KEY=

# ---------- Payments: Dodo Payments (https://dodopayments.com) ----------
DODO_API_KEY=
DODO_PRODUCT_ID=
# Dodo dashboard > Webhooks > add: https://yourdomain.com/api/payments/webhook
# Events: payment.succeeded, subscription.activated, subscription.created,
#         subscription.cancelled, payment.failed

# ---------- Email ----------
# Resend (https://resend.com) sends all transactional email
RESEND_API_KEY=
EMAIL_FROM=AgentFlow <hello@yourdomain.com>

# ---------- WhatsApp: Meta Cloud API (https://developers.facebook.com) ----------
META_APP_ID=
META_APP_SECRET=
# Any random string you choose; enter the same value in the Meta webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
# Meta app > WhatsApp > Configuration > Callback URL:
#   https://yourdomain.com/api/whatsapp/webhook   (subscribe to "messages")

# ---------- Google Calendar + Gmail OAuth ----------
# console.cloud.google.com > new project > enable Google Calendar API and Gmail API
# > Credentials > OAuth 2.0 Client ID (Web application). Authorized redirect URIs:
#   http://localhost:5000/api/calendar/callback
#   http://localhost:5000/api/gmail/callback
#   https://yourdomain.com/api/calendar/callback
#   https://yourdomain.com/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback
GOOGLE_REDIRECT_URI_GMAIL=http://localhost:5000/api/gmail/callback
